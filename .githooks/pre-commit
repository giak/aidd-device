#!/bin/sh
# pre-commit — refuse a commit whose generated docs no longer match the documents.
#
# Two signals, because they fail in different states:
#   1. regenerating rewrites a file      → the working tree was stale;
#   2. a generated file differs from the index → the commit would ship something a
#      fresh run does not produce, a hand edit typically.
# Signal 1 is the only one that works before docs/ is first committed: `git diff`
# reports nothing for an untracked file.
#
# Policy: regenerate first, then fail if anything moved. Nothing is staged for
# you: a commit must contain what you chose, never what a hook added.
#
# Install, once per clone: git config core.hooksPath .githooks

set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

generated="docs/index.md docs/dashboard.md docs/trace.md"

# `git hash-object` reads untracked files too, so this report has no blind spot.
report() {
  for file in $generated; do
    if [ -f "$file" ]; then
      printf '%s  %s\n' "$file" "$(git hash-object "$file")"
    else
      printf '%s  absent\n' "$file"
    fi
  done
}

if [ ! -f scripts/docs-index.mjs ]; then
  echo "pre-commit : scripts/docs-index.mjs est absent, docs/ ne peut pas être vérifié." >&2
  echo "Le commit est refusé plutôt que de laisser passer un état non vérifié." >&2
  exit 1
fi

report > "$work/avant"
if ! output="$(node scripts/docs-index.mjs 2>&1)"; then
  echo "pre-commit : le générateur a échoué, le commit est refusé." >&2
  printf '%s\n' "$output" >&2
  exit 1
fi
report > "$work/apres"

perimes="$(diff "$work/avant" "$work/apres" | sed -n 's/^> \([^ ][^ ]*\)  .*/\1/p')"
indexes="$(git diff --name-only -- $generated)"

if [ -z "$perimes" ] && [ -z "$indexes" ]; then
  exit 0
fi

echo "pre-commit : le tableau de bord ne correspond pas aux documents." >&2
if [ -n "$perimes" ]; then
  echo "Régénérés à l'instant, ces fichiers étaient périmés :" >&2
  printf '  %s\n' $perimes >&2
fi
if [ -n "$indexes" ]; then
  echo "Ces fichiers diffèrent de ce qui est indexé :" >&2
  printf '  %s\n' $indexes >&2
fi
echo "Regarde le diff, indexe-le (git add docs/), puis refais le commit." >&2
echo "Ces trois fichiers sont générés : ne les édite pas à la main." >&2
exit 1
